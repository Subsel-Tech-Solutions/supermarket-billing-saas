# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated allowed origins, or * for any
CORS_ORIGIN=*

# ── MySQL ───────────────────────────────────────────────
# The DB user MUST be allowed to CREATE DATABASE — every business gets its own database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
# Master (platform) database: shops, logins, platform settings
DB_NAME=supermart_master
# Each business database is named <prefix><shopId>, e.g. sm_shop_1, sm_shop_2
TENANT_DB_PREFIX=sm_shop_
# Close a shop's DB connection after this many idle minutes
TENANT_IDLE_MINUTES=30
# Max pooled connections per active shop database
TENANT_POOL_MAX=4
# Set true ONCE after upgrading the app to add new columns to existing tables, then
# set it back to false. REQUIRED when upgrading to this version: the bills table gains
# client_ref (duplicate-sale protection) and igst / inter_state / place_of_supply /
# customer_gst_number (inter-state GST invoices).
DB_SYNC_ALTER=false
DB_LOGGING=false

# ── Auth (HTTP-Only Cookies & Dual-Token) ───────────────
# Must be at least 32 characters — the server refuses to start otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
# Optional dedicated refresh secret (defaults to JWT_SECRET + "_refresh")
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_32_chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Rate limiting / proxy ───────────────────────────────
# Set false only when the app is NOT behind a reverse proxy (nginx, Railway, Render).
# When true (default) the real client IP is read from X-Forwarded-For.
TRUST_PROXY=true
# Login attempts allowed per IP+email every 15 minutes
LOGIN_RATE_LIMIT=20
# New business sign-ups allowed per IP per hour
SIGNUP_RATE_LIMIT=10
# ── Registration & Public Signup Security ────────────────
# Public signups are closed by default. Set true to explicitly allow them.
ALLOW_PUBLIC_SIGNUP=false
# Optional invite code to allow signups when ALLOW_PUBLIC_SIGNUP=false
SIGNUP_INVITE_CODE=
# Maximum number of business databases allowed before blocking new registrations
MAX_TENANTS=100
# Authenticated API requests allowed per IP per minute (a busy till does ~60)
API_RATE_LIMIT=600
# Only for local load testing
DISABLE_RATE_LIMIT=false

# Self-service password reset (Resend API key and a verified sender are required)
RESEND_API_KEY=
EMAIL_FROM=SuperMart POS <accounts@yourdomain.com>
# Public frontend URL used to build reset links
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_RATE_LIMIT=5

# ── Platform super admin (created on first start) ──────
ADMIN_EMAIL=admin@supermarket.com
# LOCAL DEV ONLY — the server refuses to start in production with this value.
# Set a strong, unique password (≥8 chars, not a common word) before deploying.
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=Admin
