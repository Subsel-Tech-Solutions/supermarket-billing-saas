{
  "name": "supermart-pos",
  "version": "1.0.0",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "cd backend && node server.js",
    "seed:e2e": "node backend/scripts/seed-e2e.js",
